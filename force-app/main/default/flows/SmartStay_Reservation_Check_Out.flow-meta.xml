<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <customErrors>
        <name>Room_Update_Failed</name>
        <label>Room Update Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The guest could not be checked out because the room status could not be updated. Details: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>FLOW 3. When Reservation Status changes to Checked-Out, sets the related Room Status to Cleaning so housekeeping prepares it before the next guest. The reservation itself is kept unchanged as history (a validation rule locks its room, guest and dates). Rooms already in Cleaning or Maintenance are not touched. A failed room update rolls back the check-out.</description>
    <environments>Default</environments>
    <interviewLabel>SmartStay - Reservation Check-Out {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SmartStay - Reservation Check-Out</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Mark_Room_For_Cleaning</name>
        <label>Mark Room For Cleaning</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Room_Update_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Room__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Room_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cleaning</stringValue>
            </value>
        </filters>
        <filters>
            <field>Room_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Maintenance</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Room_Status__c</field>
            <value>
                <stringValue>Cleaning</stringValue>
            </value>
        </inputAssignments>
        <object>Room__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Mark_Room_For_Cleaning</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Reservation_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Checked-Out</stringValue>
            </value>
        </filters>
        <filters>
            <field>Reservation_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Reservation__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
