<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Keep_Room_Reserved</name>
        <label>Keep Room Reserved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Room_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reserved</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Block_Available_While_Occupied</name>
        <label>Block Available While Occupied</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Room {!$Record.Name} cannot be made Available: reservation {!Find_Checked_In_Guest.Name} is still checked in. Check the guest out first.</errorMessage>
            <fieldSelection>Room_Status__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Arrival_Due_Today</name>
        <label>Arrival Due Today?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No arrival due</defaultConnectorLabel>
        <rules>
            <name>Has_Arrival_Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Arrival_Due</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Keep_Room_Reserved</targetReference>
            </connector>
            <label>Has Arrival Due</label>
        </rules>
    </decisions>
    <decisions>
        <name>Guest_In_House</name>
        <label>Guest In House?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Find_Arrival_Due</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No guest in house</defaultConnectorLabel>
        <rules>
            <name>Has_Checked_In_Guest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Checked_In_Guest</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Block_Available_While_Occupied</targetReference>
            </connector>
            <label>Has Checked-In Guest</label>
        </rules>
    </decisions>
    <description>FLOW 4. Runs before a Room is saved with its status changed to Available (for example housekeeping clicking Mark Room Ready). Blocks the change if a guest is still checked in. If a Confirmed reservation covers today, the room is saved as Reserved instead, because a guest is due. Otherwise it becomes Available and bookable. Uses the same rules as the Apex RoomStatusService, so the Flow and Apex never disagree.</description>
    <environments>Default</environments>
    <interviewLabel>SmartStay - Room Availability {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SmartStay - Room Availability</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Find_Arrival_Due</name>
        <label>Find Arrival Due</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Arrival_Due_Today</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Room__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Reservation_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Check_In_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Check_Out_Date__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Reservation__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Find_Checked_In_Guest</name>
        <label>Find Checked-In Guest</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Guest_In_House</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Room__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Reservation_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Checked-In</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Reservation__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Checked_In_Guest</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Room_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </filters>
        <filters>
            <field>Room_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Room__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
