<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Floor_Cannot_Be_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>Floor__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Floor__c</errorDisplayField>
    <errorMessage>Floor cannot be negative (use 0 for the ground floor).</errorMessage>
</ValidationRule>
