<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Room_Rate_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(Room_Rate__c), Room_Rate__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Room_Rate__c</errorDisplayField>
    <errorMessage>Room Rate is required and must be greater than zero.</errorMessage>
</ValidationRule>
