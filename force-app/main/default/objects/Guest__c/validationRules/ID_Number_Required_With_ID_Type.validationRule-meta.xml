<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ID_Number_Required_With_ID_Type</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(ID_Type__c, "")), ISBLANK(ID_Number__c))</errorConditionFormula>
    <errorDisplayField>ID_Number__c</errorDisplayField>
    <errorMessage>Enter the ID Number for the selected ID Type.</errorMessage>
</ValidationRule>
