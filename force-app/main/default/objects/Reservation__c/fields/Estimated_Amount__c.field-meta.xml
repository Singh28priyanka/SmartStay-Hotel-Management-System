<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Estimated_Amount__c</fullName>
    <formula>IF(ISBLANK(Number_of_Nights__c), NULL,
   Number_of_Nights__c * BLANKVALUE(Booked_Rate__c, Room__r.Room_Rate__c))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <inlineHelpText>Number of Nights x Booked Rate (falls back to the room's current rate if no rate was captured).</inlineHelpText>
    <label>Estimated Amount</label>
    <precision>12</precision>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
