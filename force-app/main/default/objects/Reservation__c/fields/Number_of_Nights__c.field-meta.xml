<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Number_of_Nights__c</fullName>
    <formula>IF(OR(ISBLANK(Check_In_Date__c), ISBLANK(Check_Out_Date__c)), NULL,
   MAX(Check_Out_Date__c - Check_In_Date__c, 0))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Number of Nights</label>
    <precision>4</precision>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
</CustomField>
