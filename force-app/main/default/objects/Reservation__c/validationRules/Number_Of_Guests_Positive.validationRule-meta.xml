<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Number_Of_Guests_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(Number_of_Guests__c), Number_of_Guests__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Number_of_Guests__c</errorDisplayField>
    <errorMessage>Number of Guests must be at least 1.</errorMessage>
</ValidationRule>
